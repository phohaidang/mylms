{
  "version": 2,
  "installCommand": "cd ../../.. && npm install",
  "buildCommand": "cd ../../.. && npx vite build core/client --outDir courses/social-commerce/D01/dist",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
